    "id": 137482769306,
    "displayJobId": "123547",
    "name": "2027 Intern - Electrification Engineering",
    "locations": [
     "Fargo,North Dakota,United States"
    ],
    "standardizedLocations": [
     "Fargo, ND, US"
    ],
    "postedTs": 1792177272,
