  "json": {
   "operationName": "GetRoles",
   "query": "query GetRoles($searchQueryInput: RoleSearchQueryInput!) {\n  roleSearch(searchQueryInput: $searchQueryInput) {\n    totalCount\n    page { pageSize pageNumber hasNext }\n    items {\n      roleId corporateTitle jobTitle jobFunction division status externalJobStatus\n      locations { primary city state country corporateRegion }\n      shortDescription lastPostedDate createdDate lastModifiedDate startDate endDate\n      educationLevel gradDegreeStartDate gradDegreeEndDate skillset skills\n      jobType { code description }\n      compensation { minSalary maxSalary currency }\n      externalSource { sourceId secondarySourceId externalSourceType }\n    }\n  }\n}",
   "variables": {
    "searchQueryInput": {
     "page": {
      "pageSize": 250,
      "pageNumber": 0
     },
     "sort": {
      "sortStrategy": "POSTED_DATE",
      "sortOrder": "DESC"
     },
     "experiences": [
      "PROFESSIONAL",
      "EARLY_CAREER",
      "CAMPUS"
     ],
     "filters": [],
     "searchTerm": ""
    }
   }
  }
 },
